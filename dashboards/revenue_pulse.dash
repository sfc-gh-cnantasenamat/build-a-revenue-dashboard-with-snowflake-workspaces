        }
      ]
    },
    "ds-accounts": {
      "type": "sql",
      "columns": [
        {
          "name": "CUSTOMER_NAME",
          "type": "VARCHAR"
        },
        {
          "name": "REGION",
          "type": "VARCHAR"
        },
        {
          "name": "SEGMENT",
          "type": "VARCHAR"
        },
        {
          "name": "NET_REVENUE",
          "type": "NUMBER"
        },
        {
          "name": "REVENUE_TARGET",
          "type": "NUMBER"
        },
        {
          "name": "VARIANCE",
          "type": "NUMBER"
        },
        {
          "name": "ATTAINMENT_PCT",
          "type": "NUMBER"
        },
        {
          "name": "GROSS_MARGIN_PCT",
          "type": "NUMBER"
        },
        {
          "name": "TOP_DRIVER",
          "type": "VARCHAR"
        }
      ],
      "sql": "SELECT CUSTOMER_NAME, REGION, SEGMENT, ROUND(SUM(NET_REVENUE), 0) AS NET_REVENUE,\n    ROUND(SUM(REVENUE_TARGET), 0) AS REVENUE_TARGET,\n    ROUND(SUM(NET_REVENUE) - SUM(REVENUE_TARGET), 0) AS VARIANCE,\n    ROUND(100 * DIV0NULL(SUM(NET_REVENUE), SUM(REVENUE_TARGET)), 1) AS ATTAINMENT_PCT,\n    ROUND(100 * DIV0NULL(SUM(GROSS_PROFIT), SUM(NET_REVENUE)), 1) AS GROSS_MARGIN_PCT,\n    MAX_BY(RECORDED_DRIVER, ABS(REVENUE_TARGET - NET_REVENUE)) AS TOP_DRIVER\nFROM (SELECT MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name, revenue.recorded_driver, customers.customer_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds))\nWHERE {{ filter('MONTH') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\nGROUP BY CUSTOMER_NAME, REGION, SEGMENT\nORDER BY VARIANCE\nLIMIT 100",
      "filter_bindings": [
        {
          "filter_id": "MONTH"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "SEGMENT"
        },
        {
          "filter_id": "PRODUCT_NAME"
        }
      ]
    }
