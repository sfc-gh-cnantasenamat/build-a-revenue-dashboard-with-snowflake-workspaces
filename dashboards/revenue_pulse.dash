{
  "spec_version": 2,
  "spec_revision": 5,
  "version": 2,
  "title": "Revenue Pulse",
  "tabs": [
    {
      "order": 0,
      "tab_id": "default",
      "title": "Overview",
      "tiles": [
        {
          "tile_id": "header",
          "type": "text",
          "text": "# Revenue Pulse\n**Synthetic demo data** for a fictional B2B software company, complete through **2026-09-30**. Source: semantic view `REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW`.\n\nNet revenue = gross revenue minus discounts and refunds. Attainment = net revenue / target. Year-over-year compares the same filtered months one year earlier. Default view: Q3 2026."
        },
        {
          "tile_id": "kpi-net-revenue",
          "title": "Net Revenue",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": false,
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "USD, vs same period last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-net-revenue"
          ]
        },
        {
          "tile_id": "kpi-attainment",
          "title": "Target Attainment",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": false,
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of target, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-attainment"
          ]
        },
        {
          "tile_id": "kpi-variance",
          "title": "Variance to Target",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 0,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": false,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": false,
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "USD, net revenue minus target"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-variance"
          ]
        },
        {
          "tile_id": "kpi-margin",
          "title": "Gross Margin",
          "type": "chart",
          "spec": {
            "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
            "data": {
              "name": "values"
            },
            "usermeta": {
              "snowflake": {
                "chartType": "scorecard",
                "scorecardConfig": {
                  "format": "decimal",
                  "decimals": 1,
                  "abbreviate": true,
                  "deltaColorMode": "increasesBetter",
                  "comparisonMode": "manual",
                  "comparisonEnabled": true,
                  "prevColumn": "PRIOR_VALUE",
                  "currentColumn": "CURRENT_VALUE",
                  "displayFormat": "change",
                  "sparklineEnabled": false,
                  "labelEnabled": true,
                  "labelField": "",
                  "labelText": "% of net revenue, vs last year"
                }
              }
            }
          },
          "datasources": [
            "ds-kpi-margin"
          ]
        },
        {
          "tile_id": "trend",
          "title": "Monthly Net Revenue vs Target (all 24 months)",
          "type": "chart",
          "spec": {
            "transform": [
              {
                "fold": [
                  "NET_REVENUE",
                  "REVENUE_TARGET"
                ],
                "as": [
                  "SERIES",
                  "VALUE"
                ]
              },
              {
                "calculate": "datum.SERIES === 'NET_REVENUE' ? 'Net revenue' : 'Target'",
                "as": "SERIES_LABEL"
              }
            ],
            "mark": {
              "type": "line",
              "point": true,
              "interpolate": "monotone"
            },
            "encoding": {
              "x": {
                "field": "MONTH",
                "type": "temporal",
                "title": "Month"
              },
              "y": {
                "field": "VALUE",
                "type": "quantitative",
                "title": "USD",
                "axis": {
                  "format": "$,.2s"
                }
              },
              "color": {
                "field": "SERIES_LABEL",
                "type": "nominal",
                "title": null,
                "scale": {
                  "domain": [
                    "Net revenue",
                    "Target"
                  ],
                  "range": [
                    "#2563a8",
                    "#8a9bb0"
                  ]
                }
              },
              "strokeDash": {
                "field": "SERIES_LABEL",
                "type": "nominal",
                "legend": null
              },
              "tooltip": [
                {
                  "field": "MONTH",
                  "type": "temporal",
                  "format": "%b %Y"
                },
                {
                  "field": "SERIES_LABEL",
                  "title": "Series"
                },
                {
                  "field": "VALUE",
                  "type": "quantitative",
                  "format": "$,.0f"
                }
              ]
            }
          },
          "datasources": [
            "ds-trend"
          ]
        },
        {
          "tile_id": "by-region",
          "title": "Variance to Target by Region",
          "type": "chart",
          "spec": {
            "mark": {
              "type": "bar",
              "cornerRadiusEnd": 3
            },
            "encoding": {
              "y": {
                "field": "REGION",
                "type": "nominal",
                "sort": "x",
                "title": null
              },
              "x": {
                "field": "VARIANCE",
                "type": "quantitative",
                "title": "USD vs target",
                "axis": {
                  "format": "$,.2s"
                }
              },
              "color": {
                "condition": {
                  "test": "datum.VARIANCE < 0",
                  "value": "#d97a2b"
                },
                "value": "#2563a8"
              },
              "tooltip": [
                {
                  "field": "REGION"
                },
                {
                  "field": "NET_REVENUE",
                  "type": "quantitative",
                  "format": "$,.0f",
                  "title": "Net revenue"
                },
                {
                  "field": "REVENUE_TARGET",
                  "type": "quantitative",
                  "format": "$,.0f",
                  "title": "Target"
                },
                {
                  "field": "VARIANCE",
                  "type": "quantitative",
                  "format": "$,.0f",
                  "title": "Variance"
                },
                {
                  "field": "ATTAINMENT",
                  "type": "quantitative",
                  "format": ".1%",
                  "title": "Attainment"
                }
              ]
            }
          },
          "datasources": [
            "ds-by-region"
          ]
        },
        {
          "tile_id": "heatmap",
          "title": "Target Attainment: Region x Segment",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "rect",
                  "stroke": "white",
                  "strokeWidth": 2
                },
                "encoding": {
                  "color": {
                    "field": "ATTAINMENT",
                    "type": "quantitative",
                    "title": "Attainment",
                    "scale": {
                      "domain": [
                        0.55,
                        1,
                        1.02,
                        1.035
                      ],
                      "range": [
                        "#d97a2b",
                        "#eaf1f8",
                        "#7fb2e5",
                        "#14365d"
                      ],
                      "clamp": true,
                      "interpolate": "rgb"
                    },
                    "legend": {
                      "format": ".1%"
                    }
                  }
                }
              },
              {
                "mark": {
                  "type": "text",
                  "fontWeight": "bold"
                },
                "encoding": {
                  "text": {
                    "field": "ATTAINMENT",
                    "type": "quantitative",
                    "format": ".1%"
                  },
                  "color": {
                    "condition": {
                      "test": "datum.ATTAINMENT >= 1.027 || datum.ATTAINMENT < 0.7",
                      "value": "white"
                    },
                    "value": "#14365d"
                  }
                }
              }
            ],
            "encoding": {
              "x": {
                "field": "SEGMENT",
                "type": "nominal",
                "title": null,
                "sort": [
                  "Enterprise",
                  "Mid-market",
                  "SMB"
                ],
                "axis": {
                  "labelAngle": 0
                }
              },
              "y": {
                "field": "REGION",
                "type": "nominal",
                "title": null
              },
              "tooltip": [
                {
                  "field": "REGION"
                },
                {
                  "field": "SEGMENT"
                },
                {
                  "field": "ATTAINMENT",
                  "type": "quantitative",
                  "format": ".1%"
                },
                {
                  "field": "VARIANCE",
                  "type": "quantitative",
                  "format": "$,.0f"
                }
              ]
            }
          },
          "datasources": [
            "ds-heatmap"
          ]
        },
        {
          "tile_id": "drivers",
          "title": "What Sales Ops Recorded: Variance by Driver",
          "type": "chart",
          "spec": {
            "transform": [
              {
                "calculate": "replace(replace(datum.RECORDED_DRIVER, 'RECORDED_', ''), /_/g, ' ')",
                "as": "DRIVER"
              }
            ],
            "mark": {
              "type": "bar",
              "cornerRadiusEnd": 3
            },
            "encoding": {
              "y": {
                "field": "DRIVER",
                "type": "nominal",
                "sort": "x",
                "title": null
              },
              "x": {
                "field": "VARIANCE",
                "type": "quantitative",
                "title": "USD vs target",
                "axis": {
                  "format": "$,.2s"
                }
              },
              "color": {
                "condition": {
                  "test": "datum.VARIANCE < 0",
                  "value": "#d97a2b"
                },
                "value": "#2563a8"
              },
              "tooltip": [
                {
                  "field": "DRIVER"
                },
                {
                  "field": "VARIANCE",
                  "type": "quantitative",
                  "format": "$,.0f"
                },
                {
                  "field": "DISCOUNTS",
                  "type": "quantitative",
                  "format": "$,.0f"
                },
                {
                  "field": "REFUNDS",
                  "type": "quantitative",
                  "format": "$,.0f"
                },
                {
                  "field": "ACCOUNTS",
                  "type": "quantitative",
                  "title": "Accounts"
                }
              ]
            }
          },
          "datasources": [
            "ds-drivers"
          ]
        },
        {
          "tile_id": "waterfall",
          "title": "Variance Bridge: How Each Recorded Driver Moves Us vs Target",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "bar",
                  "cornerRadius": 2
                },
                "encoding": {
                  "y": {
                    "field": "START_VALUE",
                    "type": "quantitative",
                    "title": "USD vs target",
                    "axis": {
                      "format": "$,.2s"
                    }
                  },
                  "y2": {
                    "field": "END_VALUE"
                  },
                  "color": {
                    "field": "KIND",
                    "type": "nominal",
                    "title": null,
                    "scale": {
                      "domain": [
                        "Increase",
                        "Decrease",
                        "Total"
                      ],
                      "range": [
                        "#7fb2e5",
                        "#d97a2b",
                        "#14365d"
                      ]
                    }
                  }
                }
              },
              {
                "mark": {
                  "type": "rule",
                  "color": "#8a9bb0"
                },
                "encoding": {
                  "y": {
                    "datum": 0
                  }
                }
              },
              {
                "mark": {
                  "type": "text",
                  "dy": -8,
                  "fontSize": 11,
                  "color": "#14365d"
                },
                "encoding": {
                  "y": {
                    "field": "LABEL_Y",
                    "type": "quantitative"
                  },
                  "text": {
                    "field": "AMOUNT",
                    "type": "quantitative",
                    "format": "$,.3s"
                  }
                }
              }
            ],
            "encoding": {
              "x": {
                "field": "STEP",
                "type": "nominal",
                "title": null,
                "sort": {
                  "field": "STEP_ORDER"
                },
                "axis": {
                  "labelAngle": 0,
                  "labelLimit": 200
                }
              },
              "tooltip": [
                {
                  "field": "STEP",
                  "title": "Step"
                },
                {
                  "field": "AMOUNT",
                  "type": "quantitative",
                  "format": "$,.0f",
                  "title": "Amount"
                },
                {
                  "field": "END_VALUE",
                  "type": "quantitative",
                  "format": "$,.0f",
                  "title": "Running variance"
                }
              ]
            }
          },
          "datasources": [
            "ds-waterfall"
          ]
        },
        {
          "tile_id": "bubble",
          "title": "Accounts: Target vs Attainment (bubble size = net revenue)",
          "type": "chart",
          "spec": {
            "layer": [
              {
                "mark": {
                  "type": "rule",
                  "strokeDash": [
                    4,
                    4
                  ],
                  "color": "#8a9bb0"
                },
                "encoding": {
                  "y": {
                    "datum": 1
                  }
                }
              },
              {
                "mark": {
                  "type": "circle",
                  "opacity": 0.75,
                  "stroke": "white",
                  "strokeWidth": 1
                },
                "encoding": {
                  "x": {
                    "field": "REVENUE_TARGET",
                    "type": "quantitative",
                    "title": "Target (USD)",
                    "axis": {
                      "format": "$,.2s"
                    },
                    "scale": {
                      "type": "log"
                    }
                  },
                  "y": {
                    "field": "ATTAINMENT",
                    "type": "quantitative",
                    "title": "Attainment",
                    "axis": {
                      "format": ".0%"
                    }
                  },
                  "size": {
                    "field": "NET_REVENUE",
                    "type": "quantitative",
                    "title": "Net revenue",
                    "scale": {
                      "range": [
                        20,
                        900
                      ]
                    },
                    "legend": null
                  },
                  "color": {
                    "field": "REGION",
                    "type": "nominal",
                    "title": "Region",
                    "scale": {
                      "domain": [
                        "Americas",
                        "EMEA",
                        "APAC"
                      ],
                      "range": [
                        "#14365d",
                        "#2563a8",
                        "#7fb2e5"
                      ]
                    }
                  },
                  "tooltip": [
                    {
                      "field": "CUSTOMER_NAME",
                      "title": "Account"
                    },
                    {
                      "field": "SEGMENT"
                    },
                    {
                      "field": "NET_REVENUE",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Net revenue"
                    },
                    {
                      "field": "REVENUE_TARGET",
                      "type": "quantitative",
                      "format": "$,.0f",
                      "title": "Target"
                    },
                    {
                      "field": "ATTAINMENT",
                      "type": "quantitative",
                      "format": ".1%"
                    }
                  ]
                }
              }
            ]
          },
          "datasources": [
            "ds-bubble"
          ]
        },
        {
          "tile_id": "ask",
          "type": "text",
          "text": "### Ask Revenue Advisor\nUse the chat box below this dashboard. Try:\n- *Why is EMEA Enterprise behind target in Q3 2026? Quantify the drivers.*\n- *Which accounts contributed most to the Q3 shortfall?*\n- *Will the renewal-delayed revenue recover in Q4?*\n- *How much of the gap is associated with discounts and refunds?*\n\nDrivers come from the `RECORDED_DRIVER` field logged by sales ops. They are recorded reasons, not inferred causes."
        },
        {
          "tile_id": "accounts",
          "title": "Account Detail (sorted by variance)",
          "type": "table",
          "spec": {
            "columns": [
              {
                "field": "CUSTOMER_NAME",
                "label": "Account"
              },
              {
                "field": "REGION",
                "label": "Region"
              },
              {
                "field": "SEGMENT",
                "label": "Segment"
              },
              {
                "field": "NET_REVENUE",
                "label": "Net revenue (USD)"
              },
              {
                "field": "REVENUE_TARGET",
                "label": "Target (USD)"
              },
              {
                "field": "VARIANCE",
                "label": "Variance (USD)"
              },
              {
                "field": "ATTAINMENT_PCT",
                "label": "Attainment %"
              },
              {
                "field": "GROSS_MARGIN_PCT",
                "label": "Gross margin %"
              },
              {
                "field": "TOP_DRIVER",
                "label": "Recorded driver"
              }
            ]
          },
          "datasources": [
            "ds-accounts"
          ]
        }
      ]
    }
  ],
  "filters": {
    "MONTH": {
      "label": "Period",
      "mode": "range",
      "valueType": "DATE",
      "default_values": [
        "2026-07-01",
        "2026-09-01"
      ]
    },
    "REGION": {
      "label": "Region",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.CUSTOMERS",
        "column": "REGION"
      }
    },
    "SEGMENT": {
      "label": "Segment",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.CUSTOMERS",
        "column": "SEGMENT"
      }
    },
    "PRODUCT_NAME": {
      "label": "Product",
      "mode": "multi_select",
      "valueType": "STRING",
      "options": {
        "source": "column",
        "table": "REVENUE_PULSE_DB.DASHBOARD_DEMO.PRODUCTS",
        "column": "PRODUCT_NAME"
      }
    }
  },
  "layout": {
    "default": {
      "meta": {
        "default": true
      },
      "positions": {
        "header": {
          "x": 0,
          "y": 0,
          "w": 12,
          "h": 2
        },
        "kpi-net-revenue": {
          "x": 0,
          "y": 2,
          "w": 3,
          "h": 2
        },
        "kpi-attainment": {
          "x": 3,
          "y": 2,
          "w": 3,
          "h": 2
        },
        "kpi-variance": {
          "x": 6,
          "y": 2,
          "w": 3,
          "h": 2
        },
        "kpi-margin": {
          "x": 9,
          "y": 2,
          "w": 3,
          "h": 2
        },
        "trend": {
          "x": 0,
          "y": 4,
          "w": 12,
          "h": 4
        },
        "by-region": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "heatmap": {
          "x": 6,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "drivers": {
          "x": 0,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "waterfall": {
          "x": 6,
          "y": 12,
          "w": 6,
          "h": 4
        },
        "bubble": {
          "x": 0,
          "y": 16,
          "w": 8,
          "h": 5
        },
        "ask": {
          "x": 8,
          "y": 16,
          "w": 4,
          "h": 5
        },
        "accounts": {
          "x": 0,
          "y": 21,
          "w": 12,
          "h": 6
        }
      }
    }
  },
  "datasources": {
    "ds-kpi-net-revenue": {
      "type": "sql",
      "columns": [
        {
          "name": "CURRENT_VALUE",
          "type": "NUMBER"
        },
        {
          "name": "PRIOR_VALUE",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH cur AS (\n    SELECT SUM(NET_REVENUE) AS NET, SUM(REVENUE_TARGET) AS TGT, SUM(GROSS_PROFIT) AS GP FROM (SELECT MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds))\n    WHERE {{ filter('MONTH') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n),\npy AS (\n    SELECT SUM(NET_REVENUE) AS NET, SUM(REVENUE_TARGET) AS TGT, SUM(GROSS_PROFIT) AS GP FROM (SELECT DATEADD(YEAR, 1, MONTH) AS MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds))\n    WHERE {{ filter('MONTH') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n)\nSELECT cur.NET AS CURRENT_VALUE, py.NET AS PRIOR_VALUE\nFROM cur CROSS JOIN py",
      "filter_bindings": [
        {
          "filter_id": "MONTH"
        },
        {
          "filter_id": "REGION"
        },
        {
          "filter_id": "SEGMENT"
        },
        {
          "filter_id": "PRODUCT_NAME"
        }
      ]
    },
    "ds-kpi-attainment": {
      "type": "sql",
      "columns": [
        {
          "name": "CURRENT_VALUE",
          "type": "NUMBER"
        },
        {
          "name": "PRIOR_VALUE",
          "type": "NUMBER"
        }
      ],
      "sql": "WITH cur AS (\n    SELECT SUM(NET_REVENUE) AS NET, SUM(REVENUE_TARGET) AS TGT, SUM(GROSS_PROFIT) AS GP FROM (SELECT MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds))\n    WHERE {{ filter('MONTH') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n),\npy AS (\n    SELECT SUM(NET_REVENUE) AS NET, SUM(REVENUE_TARGET) AS TGT, SUM(GROSS_PROFIT) AS GP FROM (SELECT DATEADD(YEAR, 1, MONTH) AS MONTH, * EXCLUDE (MONTH) FROM SEMANTIC_VIEW(\n        REVENUE_PULSE_DB.DASHBOARD_DEMO.REVENUE_SEMANTIC_VIEW\n        DIMENSIONS revenue.month, customers.region, customers.segment, products.product_name\n        METRICS revenue.net_revenue, revenue.revenue_target, revenue.gross_profit, revenue.total_discounts, revenue.total_refunds))\n    WHERE {{ filter('MONTH') }}\n    AND {{ filter('REGION') }}\n    AND {{ filter('SEGMENT') }}\n    AND {{ filter('PRODUCT_NAME') }}\n)\nSELECT 100 * DIV0NULL(cur.NET, cur.TGT) AS CURRENT_VALUE, 100 * DIV0NULL(py.NET, py.TGT) AS PRIOR_VALUE\nFROM cur CROSS JOIN py",
